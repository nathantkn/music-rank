# Database connection string, read by Prisma (prisma/schema.prisma:13)
# Local development (SQLite):
# DATABASE_URL="file:./dev.db"
# Production (PostgreSQL / Supabase):
DATABASE_URL="postgresql://postgres.___:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:XXXX/postgres"

# Spotify API credentials — https://developer.spotify.com/dashboard
# Used by src/server/services/spotifyAuth.js:5 for the client-credentials flow
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: API server port (src/server/index.js:449, defaults to 4000)
PORT=4000
